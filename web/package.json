{
	"name": "robocode-s-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"wasm": "tools/build-wasm.sh",
		"dev": "pnpm wasm && vite dev",
		"build": "pnpm wasm && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm wasm && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "pnpm wasm && vitest",
		"test": "pnpm wasm && vitest --run"
	},
	"devDependencies": {
		"@fontsource/archivo-black": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"flag-icons": "^7.5.0",
		"mdsvex": "^0.12.7",
		"rehype-slug": "^6.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24"
	}
}
